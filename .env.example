NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-publishable-auth-key
CACU_ACCOUNTING_API_URL=https://your-python-preview.vercel.app
# OpenAI server-only configuration. Never prefix the API key with NEXT_PUBLIC_.
# Provider setup alone does not activate the assistant or HR generation.
OPENAI_API_KEY=replace-with-project-api-key
OPENAI_MODEL=replace-with-approved-model-id
# Optional separate upload backend; defaults to CACU_ACCOUNTING_API_URL.
CACU_UPLOAD_API_URL=https://your-python-preview.vercel.app

# General-guidance pilot requires the reviewed database migration/settings too.
CACU_AI_ENABLED=false
# Answers from the books (Doc 15, E18 R3). Leave false until gate G4: provider data terms signed, evaluation bars met.
CACU_AI_BOOKS_ENABLED=false

# AI-on-the-books evaluation (npm run ai:eval; Doc 15, TEST-411). Staging only; leave unset everywhere else.
# AI_EVAL_ENVIRONMENT=staging
# AI_EVAL_SUPABASE_URL=https://<staging-ref>.supabase.co
# AI_EVAL_SUPABASE_ANON_KEY=replace-with-staging-anon-key
# AI_EVAL_ACCOUNTING_API_URL=https://<staging-accounting-api>
# AI_EVAL_FIXTURES=<path outside the repository>/fixtures.json
# AI_EVAL_MODEL=replace-with-model-under-evaluation
# Seeding the staging fixtures (backend/tools/seed_ai_eval.py) also needs these, staging only:
# AI_EVAL_SUPABASE_SERVICE_KEY=replace-with-staging-secret-key
# CACU_MIGRATION_DATABASE_URL=replace-with-privileged-staging-database-url
