NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-publishable-auth-key
CACU_ACCOUNTING_API_URL=https://your-python-preview.vercel.app
# OpenAI server-only configuration. Never prefix the API key with NEXT_PUBLIC_.
# Provider setup alone does not activate the assistant or HR generation.
OPENAI_API_KEY=replace-with-project-api-key
OPENAI_MODEL=replace-with-approved-model-id
# Optional separate upload backend; defaults to CACU_ACCOUNTING_API_URL.
CACU_UPLOAD_API_URL=https://your-python-preview.vercel.app
