SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-auth-key
CACU_DATABASE_URL=postgresql://cacu_runtime.project:placeholder@pooler-host:6543/postgres
# Configure root certificate through PGSSLROOTCERT; never disable TLS verification.
PGSSLROOTCERT=/path/to/reviewed-ca.crt
# Python storage operations only; secret legacy service-role JWT, never NEXT_PUBLIC_.
CACU_STORAGE_SERVICE_ROLE_KEY=replace-with-server-only-storage-service-role-jwt
