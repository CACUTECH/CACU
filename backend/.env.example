SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-auth-key
CACU_DATABASE_URL=postgresql://cacu_runtime.project:placeholder@pooler-host:6543/postgres
# Optional override; relative paths resolve from the backend root.
# The bundled public CA below is used automatically when unset.
PGSSLROOTCERT=certs/supabase-root-2021.crt
# Python storage operations only; secret legacy service-role JWT, never NEXT_PUBLIC_.
CACU_STORAGE_SERVICE_ROLE_KEY=replace-with-server-only-storage-service-role-jwt
# CACU subscription billing (Doc 14). Server-only secret; test keys start sk_test_. Never NEXT_PUBLIC_.
PAYSTACK_SECRET_KEY=replace-with-paystack-secret-key
# Where Paystack sends the owner after checkout; the app then asks the API to verify (never trusts the redirect).
CACU_BILLING_CALLBACK_URL=https://your-app.example.com/settings/billing
