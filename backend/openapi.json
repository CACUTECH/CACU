  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InvoiceCreate": {
        "properties": {
          "request_key": {
            "type": "string",
            "format": "uuid",
            "title": "Request Key"
          },
          "customer_id": {
            "type": "string",
            "format": "uuid",
            "title": "Customer Id"
          },
          "invoice_number": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Invoice Number"
          },
          "entry_date": {
            "type": "string",
            "format": "date",
            "title": "Entry Date"
          },
          "due_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Due Date"
          },
          "notes": {
            "type": "string",
            "maxLength": 1000,
            "title": "Notes",
            "default": ""
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/InvoiceItem"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Items"
          },
          "tax": {
            "type": "string",
            "pattern": "^[0-9]{1,13}(\\.[0-9]{1,2})?$",
            "title": "Tax",
            "default": "0.00"
          },
          "issue": {
            "type": "boolean",
            "title": "Issue",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_key",
          "customer_id",
          "invoice_number",
          "entry_date",
          "items"
        ],
        "title": "InvoiceCreate"
      },
      "InvoiceItem": {
        "properties": {
          "catalog_item_id": {
            "type": "string",
            "format": "uuid",
            "title": "Catalog Item Id"
          },
          "quantity": {
            "type": "integer",
            "maximum": 1000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Quantity"
          },
          "unit_price": {
            "type": "string",
            "pattern": "^[0-9]{1,13}(\\.[0-9]{1,2})?$",
            "title": "Unit Price"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "catalog_item_id",
          "quantity",
          "unit_price"
        ],
        "title": "InvoiceItem"
      },
      "JournalDraft": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "memo": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Memo"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/JournalLine"
            },
            "type": "array",
            "maxItems": 200,
            "minItems": 2,
            "title": "Lines"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "date",
          "memo",
          "lines"
        ],
        "title": "JournalDraft"
      },
      "JournalLine": {
        "properties": {
          "account_id": {
            "type": "string",
            "format": "uuid",
            "title": "Account Id"
          },
          "debit": {
            "type": "string",
            "title": "Debit",
            "default": "0.00"
          },
          "credit": {
            "type": "string",
            "title": "Credit",
            "default": "0.00"
          },
          "description": {
            "type": "string",
            "maxLength": 500,
            "title": "Description",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "account_id"
        ],
        "title": "JournalLine"
      },
      "JournalPosting": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "memo": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Memo"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/JournalLine"
            },
            "type": "array",
            "maxItems": 200,
            "minItems": 2,
            "title": "Lines"
          },
          "request_key": {
            "type": "string",
            "format": "uuid",
            "title": "Request Key"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "date",
          "memo",
          "lines",
          "request_key"
        ],
        "title": "JournalPosting"
      },
      "JournalValidation": {
        "properties": {
          "valid": {
            "type": "boolean",
            "title": "Valid"
          },
          "total_debit": {
            "type": "string",
            "title": "Total Debit"
          },
          "total_credit": {
            "type": "string",
            "title": "Total Credit"
          },
          "persisted": {
            "type": "boolean",
            "title": "Persisted",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "valid",
          "total_debit",
          "total_credit"
        ],
        "title": "JournalValidation"
      },
      "PostingCommand": {
        "properties": {
          "request_key": {
            "type": "string",
            "format": "uuid",
            "title": "Request Key"
          },
          "kind": {
            "type": "string",
            "enum": [
              "invoice",
              "receipt",
              "bill",
              "supplier_payment",
              "expense",
              "pos",
              "adjustment",
              "credit_note",
              "transfer",
              "reversal"
            ],
            "title": "Kind"
          },
          "source_id": {
            "type": "string",
            "format": "uuid",
            "title": "Source Id"
          },
          "target_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Id"
          },
          "main_account_id": {
            "type": "string",
            "format": "uuid",
            "title": "Main Account Id"
          },
          "entry_date": {
            "type": "string",
            "format": "date",
            "title": "Entry Date"
          },
          "narration": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Narration"
          },
          "credited": {
            "type": "boolean",
            "title": "Credited",
            "default": true
          },
          "main_amount": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9]{1,13}(\\.[0-9]{1,2})?$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Main Amount"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/PostingLine"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Lines"
          },
          "stock": {
            "items": {
              "$ref": "#/components/schemas/StockLine"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Stock"
          },
          "counterparty_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Counterparty Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_key",
          "kind",
          "source_id",
          "main_account_id",
          "entry_date",
          "narration",
          "lines"
        ],
        "title": "PostingCommand"
      },
      "PostingLine": {
        "properties": {
          "account_id": {
            "type": "string",
            "format": "uuid",
