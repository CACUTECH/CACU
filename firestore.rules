rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // P0 FIX: Default Deny Posture
    match /{document=**} {
      allow read, write: if false;
    }

    // AUTHENTICATION HELPERS
    function isAuthenticated() {
      // P0 FIX: Strict identity and email verification check
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // P0 FIX: High Performance Authorization (O(1) cost and latency)
    // Uses Firebase Custom Claims set by the backend
    function getBusinessId() {
      return request.auth.token.businessId;
    }

    function getRole() {
      return request.auth.token.role;
    }

    function isMember(businessId) {
      return isAuthenticated() && (getBusinessId() == businessId || request.auth.uid == businessId);
    }

    function hasRole(businessId, roles) {
      return isMember(businessId) && getRole() in roles;
    }

    // DATA VALIDATION HELPERS
    function isValidPrice(price) {
      return price is number && price >= 0;
    }

    // MULTI-TENANT COLLECTIONS
    match /businesses/{businessId} {
      // Root Profile Access
      allow read: if isMember(businessId);
      allow create: if isAuthenticated(); // Handled by trusted Server Action
      allow update: if hasRole(businessId, ['Owner', 'Admin']);

      // USER PROFILES (Within Business)
      match /users/{userId} {
        allow read: if isMember(businessId);
        allow write: if hasRole(businessId, ['Owner', 'Admin']) || (request.auth.uid == userId);
      }

      // INVENTORY (Strict Schema Enforcement)
      match /catalog/{itemId} {
        allow read: if isMember(businessId);
        allow write: if hasRole(businessId, ['Owner', 'Admin', 'Editor']) &&
                      isValidPrice(request.resource.data.price);
      }

      // TRANSACTIONS (Immutability for Audit Integrity)
      match /transactions/{txId} {
        allow read: if isMember(businessId);
        allow create: if hasRole(businessId, ['Owner', 'Admin', 'Editor']);
        // P1 FIX: Prevent tampering with recorded history
        allow update, delete: if false;
      }

      // EMPLOYEES
      match /employees/{empId} {
        allow read: if hasRole(businessId, ['Owner', 'Admin', 'HR']);
        allow write: if hasRole(businessId, ['Owner', 'Admin', 'HR']);
      }
    }
  }
}